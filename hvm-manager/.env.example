# ── HVM Customize \u2014 environment config ───────────────────────────
# Copy this file to ".env" and fill in your own values.
# Never commit your real ".env" to GitHub.

# Port the panel itself listens on
PORT=5000

# Secret used to sign JWT session tokens \u2014 change this to a long random string
JWT_SECRET=change_this_to_a_long_random_string

# First admin account, auto-created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Path to the SQLite database file
DB_PATH=./data/hvm.db

# Docker socket path (default is fine for most Linux VPS setups)
DOCKER_SOCKET=/var/run/docker.sock

# Default resource caps applied when an admin doesn't set a custom value
DEFAULT_RAM_MB=1024
DEFAULT_CPU_CORES=1

# Panel branding defaults (all editable later from Settings \u2192 Branding)
PANEL_NAME=HVM Manager
OWNER_NAME=blaze_gazzer
DISCORD_LINK=
TELEGRAM_LINK=
